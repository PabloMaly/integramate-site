# The canonical origin, used by astro.config.mjs for the canonical links, the sitemap and the social image URLs.
SITE_URL=https://integramate-site.pablomaly.me

# The API the request-access form posts to (POST /leads). Its LANDING_ORIGINS must list this site's origin.
PUBLIC_API_URL=http://localhost:3000

# The public site key of the Turnstile widget whose hostnames include this site. Empty renders no widget, which only
# works against an API with no Turnstile secret (development). Cloudflare's always-passing test key is 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
