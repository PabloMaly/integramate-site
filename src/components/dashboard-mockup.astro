---
import { Picture } from 'astro:assets';
import dashboard from '@/assets/screens/dashboard.png';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale).screens;
---

<div
  class="mx-auto w-full max-w-[1100px] overflow-hidden rounded-t-[28px] border border-b-0 border-border bg-surface shadow-pop [mask-image:linear-gradient(to_bottom,black_65%,transparent)]"
>
  <div class="flex items-center gap-2 border-b border-border bg-surface px-5 py-4" aria-hidden="true">
    <span class="size-3 rounded-full bg-danger-700"></span>
    <span class="size-3 rounded-full bg-primary-400"></span>
    <span class="size-3 rounded-full bg-success-700"></span>
  </div>
  <Picture
    src={dashboard}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 1100, 1600, 2200]}
    sizes="(min-width: 1148px) 1100px, calc(100vw - 32px)"
    alt={t.dashboard}
    loading="eager"
    fetchpriority="high"
    class="block w-full"
  />
</div>
