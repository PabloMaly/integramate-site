---
import Eyebrow from '@/components/eyebrow.astro';
import { localeUrl, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).showcase;
const home = localeUrl(locale);

const icons: Record<string, string> = {
  dashboard: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z',
  automations: 'M13 2 4 14h7l-1 8 9-12h-7Z',
  inbox: 'M3 13h5l1.5 3h5l1.5-3h5M5.5 5h13L21 13v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6Z',
  executions: 'M3 12h4l3-8 4 16 3-8h4',
  team: 'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM20 20v-1.5a3.5 3.5 0 0 0-2.5-3.4M15.5 4.2a3.5 3.5 0 0 1 0 6.6',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1',
};

const ticks = [100, 80, 60, 40, 20, 0];
const bars = [
  [58, 44],
  [79, 52],
  [96, 74],
  [84, 41],
];
---

<section class="mx-auto max-w-[1200px] px-6 py-24">
  <div
    class="relative grid overflow-hidden rounded-[32px] border border-border bg-gradient-to-br from-primary-50 via-surface to-primary-50 md:min-h-[560px] md:grid-cols-[1.1fr_1fr]"
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-24 [background-image:linear-gradient(to_right,var(--primary-100)_1px,transparent_1px)] [background-size:112px_100%] [mask-image:linear-gradient(to_left,black,transparent_75%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute left-[38%] top-1/4 h-1/2 w-40 bg-primary-200 opacity-50 blur-[70px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex flex-col justify-center gap-8 px-8 py-14 md:pl-12 md:pr-4 lg:pl-14">
      <div><Eyebrow icon="dot">{t.eyebrow}</Eyebrow></div>
      <h2 class="text-balance text-[36px] font-medium leading-[1.08] tracking-[-0.035em] md:text-[40px] lg:text-[50px]">
        {t.title}
      </h2>
      <div class="flex flex-wrap gap-3">
        <a
          href={`${home}#contact`}
          class="rounded-xl bg-gradient-to-b from-primary-600 to-primary-700 px-7 py-4 text-[17px] font-medium text-white shadow-[0_14px_28px_-10px_rgba(181,80,31,0.7),inset_0_1px_0_rgba(255,255,255,0.35)]"
        >
          {t.primary}
        </a>
        <a
          href={`${home}#pricing`}
          class="rounded-xl border border-border bg-surface px-7 py-4 text-[17px] font-medium text-fg shadow-pop"
        >
          {t.secondary}
        </a>
      </div>
    </div>

    <div class="relative min-h-[420px] md:min-h-0" aria-hidden="true">
      <div
        class="absolute left-6 top-0 flex h-[560px] w-[760px] overflow-hidden rounded-tl-2xl border border-border bg-surface shadow-pop md:left-0 md:top-16"
      >
        <div class="w-[230px] shrink-0 border-r border-border bg-surface-muted p-4">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2 text-[17px] font-medium">
              <svg width="24" height="24" viewBox="0 0 32 32">
                <rect width="32" height="32" rx="8" fill="var(--primary-500)"></rect>
                <path d="M9 22V10h3v12zm5 0V10h3l6 8.5V10h3v12h-3l-6-8.5V22z" fill="#fff"></path>
              </svg>
              Integramate
            </span>
            <span class="flex size-6 items-center justify-center rounded-md border border-border bg-surface text-fg-secondary">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 6-6 6 6 6"></path>
              </svg>
            </span>
          </div>
          <div class="mt-5 flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-[13px] text-fg-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <circle cx="10.5" cy="10.5" r="6.5"></circle>
              <path d="m20 20-4.5-4.5"></path>
            </svg>
            <span class="flex-1">{t.app.search}</span>
            <span class="rounded bg-surface-muted px-1.5 text-[11px]">⌘</span>
            <span class="rounded bg-surface-muted px-1.5 text-[11px]">K</span>
          </div>
          {
            t.app.groups.map((group, g) => (
              <div class="mt-5">
                <p class="px-2.5 text-[11px] uppercase tracking-[0.03em] text-fg-tertiary">{group.label}</p>
                <ul class="mt-2 flex flex-col gap-1 text-[13.5px] text-fg-secondary">
                  {group.items.map((item, i) => {
                    const active = g === 0 && i === 0;
                    return (
                      <li
                        class:list={[
                          'relative flex items-center gap-2.5 rounded-lg px-2.5 py-2',
                          active && 'border border-border bg-surface text-fg shadow-[0_1px_2px_rgba(10,10,10,0.05)]',
                        ]}
                      >
                        {active && <span class="absolute -left-4 top-1/2 h-5 w-[3px] -translate-y-1/2 rounded-r bg-primary-500" />}
                        <svg
                          class:list={[active && 'text-primary-500']}
                          width="17"
                          height="17"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d={icons[item.icon]} />
                        </svg>
                        {item.label}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="min-w-0 flex-1 p-6">
          <p class="border-b border-border pb-4 text-[13px] text-fg">{t.app.title}</p>
          <p class="mt-5 text-[19px] font-medium tracking-[-0.01em]">{t.app.title}</p>
          <div class="mt-4 rounded-xl border border-border">
            <p class="border-b border-border px-4 py-3 text-[14px] font-medium">{t.app.chartTitle}</p>
            <div class="p-4">
              <p class="flex items-baseline gap-2">
                <span class="text-[24px] font-medium tracking-[-0.02em]">{t.app.value}</span>
                <span class="text-[12px] font-medium text-success-700">↑ {t.app.change}</span>
                <span class="text-[12px] text-fg-secondary">{t.app.comparison}</span>
              </p>
              <div class="mt-5 flex h-[210px] gap-3">
                <div class="flex flex-col justify-between pb-6 text-[10.5px] text-fg-tertiary">
                  {ticks.map((tick) => <span class="flex h-0 items-center justify-end">{tick}</span>)}
                </div>
                <div class="relative flex-1">
                  <div class="absolute inset-x-0 bottom-6 top-0 flex flex-col justify-between">
                    {ticks.map(() => <span class="h-0 border-t border-dashed border-border" />)}
                  </div>
                  <div class="absolute inset-x-0 bottom-6 top-0 flex items-end justify-around">
                    {bars.map(([current, previous]) => (
                      <div class="flex h-full w-[24%] items-end">
                        <div
                          class="flex-1 border-t-2 border-primary-500"
                          style={`height:${current}%;background:repeating-linear-gradient(135deg,var(--primary-300) 0 1.5px,var(--primary-50) 1.5px 6px)`}
                        />
                        <div
                          class="flex-1 border-t-2 border-primary-300"
                          style={`height:${previous}%;background:repeating-linear-gradient(135deg,var(--primary-200) 0 1.5px,var(--surface) 1.5px 6px)`}
                        />
                      </div>
                    ))}
                  </div>
                  <div class="absolute inset-x-0 bottom-0 flex justify-around text-[11px] text-fg-secondary">
                    {t.app.days.map((day) => <span class="w-[24%] text-center">{day}</span>)}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
