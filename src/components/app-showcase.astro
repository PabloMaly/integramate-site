---
import { Picture } from 'astro:assets';
import appShell from '@/assets/screens/app-shell.png';
import Eyebrow from '@/components/eyebrow.astro';
import { localeUrl, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localeUrl(locale);
---

<section class="mx-auto max-w-[1200px] px-6 py-24">
  <div
    class="relative grid overflow-hidden rounded-[32px] border border-border bg-gradient-to-br from-primary-50 via-surface to-primary-50 md:min-h-[560px] md:grid-cols-[1.1fr_1fr]"
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-24 [background-image:linear-gradient(to_right,var(--primary-100)_1px,transparent_1px)] [background-size:112px_100%] [mask-image:linear-gradient(to_left,black,transparent_75%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute left-[38%] top-1/4 h-1/2 w-40 bg-primary-200 opacity-50 blur-[70px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex flex-col justify-center gap-8 px-8 py-14 md:pl-12 md:pr-4 lg:pl-14">
      <div><Eyebrow icon="dot">{t.showcase.eyebrow}</Eyebrow></div>
      <h2 class="text-balance text-[36px] font-medium leading-[1.08] tracking-[-0.035em] md:text-[40px] lg:text-[50px]">
        {t.showcase.title}
      </h2>
      <div class="flex flex-wrap gap-3">
        <a
          href={`${home}#contact`}
          class="rounded-xl bg-gradient-to-b from-primary-600 to-primary-700 px-7 py-4 text-[17px] font-medium text-white shadow-[0_14px_28px_-10px_rgba(181,80,31,0.7),inset_0_1px_0_rgba(255,255,255,0.35)]"
        >
          {t.showcase.primary}
        </a>
        <a
          href={`${home}#pricing`}
          class="rounded-xl border border-border bg-surface px-7 py-4 text-[17px] font-medium text-fg shadow-pop"
        >
          {t.showcase.secondary}
        </a>
      </div>
    </div>

    <div class="relative min-h-[420px] md:min-h-0">
      <div
        class="absolute left-6 top-0 h-[560px] w-[760px] overflow-hidden rounded-tl-2xl border border-border bg-surface shadow-pop md:left-0 md:top-16"
      >
        <Picture
          src={appShell}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[760, 1520]}
          sizes="760px"
          alt={t.screens.appShell}
          loading="lazy"
          class="block w-full"
        />
      </div>
    </div>
  </div>
</section>
