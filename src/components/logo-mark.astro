---
// The app's mark (packages/ui logo.tsx): a stylised "i" built from connected nodes.
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 36 36" class="shrink-0" aria-hidden="true">
  <circle cx="18" cy="18" r="18" fill="var(--primary-500)"></circle>
  <path d="M18 14.2V26.5M18 19.5 11.6 15.2M18 19.5 24.4 15.2" stroke="#fff" stroke-opacity=".55" stroke-width="1.5" stroke-linecap="round"></path>
  <circle cx="18" cy="10.2" r="2.6" fill="#fff"></circle>
  <circle cx="18" cy="19.5" r="2.1" fill="#fff"></circle>
  <circle cx="18" cy="26.5" r="2.1" fill="#fff"></circle>
  <circle cx="11.6" cy="15.2" r="1.5" fill="#fff" fill-opacity=".85"></circle>
  <circle cx="24.4" cy="15.2" r="1.5" fill="#fff" fill-opacity=".85"></circle>
</svg>
