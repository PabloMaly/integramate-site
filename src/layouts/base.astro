---
import '@/styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { Locale } from '@/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const locales = ['en', 'es'] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'es' ? 'es_419' : 'en_US'} />
  </head>
  <body>
    <slot />
    <script>
      // Remember a manual language choice so the geolocation redirect stops overriding it.
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((link) => {
        link.addEventListener('click', () => {
          document.cookie = `lang=${link.dataset.lang}; path=/; max-age=31536000; SameSite=Lax; Secure`;
        });
      });
    </script>
  </body>
</html>
